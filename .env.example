# ==============================================================================
# Utsav Planner - Environment Configuration (.env.example)
# Copy this file to .env.local for local development. NEVER commit .env.local!
# ==============================================================================

# Gemini API Key (Server-only, NEVER prefix with NEXT_PUBLIC_)
# Obtain from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY="AIzaSy_YOUR_API_KEY_HERE"

# Gemini Model Name (REQUIRED - no code default)
# Recommended stable Flash model per official documentation:
#   - gemini-3.8-flash (Standard, fast & intelligent)
#   - gemini-3.5-flash-lite (Cost-effective fallback)
GEMINI_MODEL="gemini-3.8-flash"

# AI Provider Mode: "gemini" (default) or "mock" (offline/CI testing mode)
AI_PROVIDER="gemini"

# Daily Cap on AI calls per server instance (safety net before provider quota)
AI_DAILY_CALL_CAP="500"
